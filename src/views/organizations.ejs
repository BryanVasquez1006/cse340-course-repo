 <%- include('partials/header') %>
    <main>
      <h1><%= title %></h1>
      <p>Here are a few of our partner organizations:</p>
      <ul>
<% organizations.forEach(organization => { %>

  <li>
    <img
      src="/images/<%= organization.logo_filename %>"
      alt="<%= organization.name %> logo">
      <strong><%= organization.name %></strong>
      <a href="/organizations/<%= organization.organization_id %>"><%= organization.name %></a>
      <p><%= organization.contact_email %></p>
      <p><%= organization.description %></p>
  </li>

<% }); %>

      </ul>
      <p><a href="/new-organization">Add a new organization</a></p>

    </main>

    <%- include('partials/footer') %>
