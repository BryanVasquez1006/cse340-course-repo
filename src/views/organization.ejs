<%- include ('partials/header') %>
    <main>
        <h2><%= organizationDetails.name %></h2>
        <img
          class="organization_img"
          src="/images/<%= organizationDetails.logo_filename %>"
          alt="<%= organizationDetails.name %> Logo"
        />
        <p><%= organizationDetails.description %></p>
    
        <h3>Service Projects</h3>
        <ul>
            <% projects.forEach(project => { %>
                <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }); %>
        </ul>
        <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit this organization</a></p>
        <p>Contact Email: <%= organizationDetails.contact_email %></p>
    </main>

<%- include ('partials/footer') %>
