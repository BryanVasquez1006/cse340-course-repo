<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p><%= projectDetails.description %></p>
    <p>
        <strong>Location:</strong> <%= projectDetails.location %>
    </p>
    <p>
        <strong>Start Date:</strong> <%= projectDetails.date %>
    </p>
    <p>
        <strong>Organization:</strong>
        <a href="/organizations/<%= projectDetails.organization_id %>"> <%= projectDetails.organization_name %></a>
    </p>
    <ul>
        <h2>Categories</h2>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>"><%= category.name %></a>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>