<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>
  <h2>Upcoming Service Projects</h2>

  <ul>
    <% projects.forEach(project => { %>
      <li>
        <p>
          <strong>Date:</strong>
          <%= project.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC'
          }) %>:
          <%= project.title %>
          (<em><%= project.organization_name %></em>)
        </p>
      </li>
    <% }); %>
  </ul>
</main>

<%- include('partials/footer') %>